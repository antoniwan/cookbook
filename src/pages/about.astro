---
import Base from '../layouts/Base.astro';
---

<Base title="Our kitchen — Cookbook" path="/about">
  <main class="about-page" id="main">
    <article class="book">
      <section class="book-page left">
        <h1>A family recipe book.</h1>
        <div class="about-prose">
          <p>
            Puerto Rican staples, everyday meals, breakfasts, and things to bake. Many come in
            English and Spanish; the language link on each recipe takes you to its twin.
          </p>
          <p>
            Check off ingredients, adjust quantities, tap the step you're on, print, or turn on
            kitchen mode while you cook.
          </p>
          <p>
            For the stories around the food, there’s{' '}
            <a
              href="https://notes.antoniwan.online/p/i-didnt-start-cooking-for-love"
              data-umami-event="cta"
              data-umami-event-label="cooking-for-love"
            >
              I Didn’t Start Cooking for Love
            </a>{' '}
            on Notes.
          </p>
          <a
            class="button"
            href="/#recipes"
            data-umami-event="cta"
            data-umami-event-label="back-to-recipes"
          >
            Back to the recipes ↗
          </a>
        </div>
        <span class="folio" aria-hidden="true">
          i
        </span>
      </section>
      <section class="book-page right">
        <img
          class="page-illustration"
          src="/mascots.webp"
          width="1536"
          height="1024"
          alt="Cookbook’s garlic bulb and strawberry mascots."
        />
        <p class="bubble bubble-static">A little savory, a little sweet.</p>
        <span class="folio" aria-hidden="true">
          ii
        </span>
      </section>
    </article>
  </main>
</Base>
