---
import Base from '../layouts/Base.astro';
import { allRecipes } from '../lib/catalogue';
import { safeJson } from '../lib/recipe';
import { recipeListStructuredData } from '../lib/seo';
const all = await allRecipes();
const recipes = all
  .filter((recipe) => recipe.data.language[0] === 'en')
  .sort((first, second) => first.data.title.localeCompare(second.data.title));
const letters = [...new Set(recipes.map((recipe) => recipe.data.title[0].toUpperCase()))];
// Split the letters so each page of the spread holds about half the recipes.
let running = 0;
const firstPage = letters.filter((letter) => {
  const keep = running < recipes.length / 2;
  running += recipes.filter((recipe) => recipe.data.title.startsWith(letter)).length;
  return keep;
});
const pages = [firstPage, letters.filter((letter) => !firstPage.includes(letter))];
---

<Base title="Recipes, A–Z — Cookbook" path="/contents">
  <script
    slot="head"
    type="application/ld+json"
    set:html={safeJson(recipeListStructuredData(recipes, '/contents'))}
  />
  <main class="contents-page" id="main">
    <article class="book">
      {pages.map((pageLetters, pageIndex) => (
        <section class={`book-page ${pageIndex === 0 ? 'left' : 'right'}`}>
          {pageIndex === 0 && (
            <>
              <p class="tag">Recipe index</p>
              <h1>Recipes, A to Z.</h1>
              <p class="page-dek">{recipes.length} recipes.</p>
              <nav class="letter-nav" aria-label="Jump to a letter">
                {letters.map((letter) => (
                  <a href={`#letter-${letter}`}>{letter}</a>
                ))}
              </nav>
            </>
          )}
          {pageLetters.map((letter) => (
            <section class="letter-section" id={`letter-${letter}`}>
              <h2>{letter}</h2>
              <ul>
                {recipes
                  .filter((recipe) => recipe.data.title.startsWith(letter))
                  .map((recipe) => (
                    <li>
                      <a href={`/recipes/${recipe.id}`}>
                        {recipe.data.title}
                        <span aria-hidden="true">↗</span>
                      </a>
                      {recipe.data.translationGroup && <span class="language-note">EN / ES</span>}
                    </li>
                  ))}
              </ul>
            </section>
          ))}
          <span class="folio" aria-hidden="true">
            {pageIndex + 2}
          </span>
        </section>
      ))}
    </article>
  </main>
</Base>
