---
import Base from '../layouts/Base.astro';
import RecipeCard from '../components/RecipeCard.astro';
import MascotIcon from '../components/MascotIcon.astro';
import IdleBook from '../components/IdleBook.astro';
import { allRecipes } from '../lib/catalogue';
import { recipeImage } from '../lib/images';
import { GROUPS, recipeGroup, safeJson } from '../lib/recipe';
import { recipeListStructuredData } from '../lib/seo';
const all = await allRecipes();
const recipes = all
  .filter((recipe) => recipe.data.language[0] === 'en')
  .sort((first, second) => first.data.title.localeCompare(second.data.title));
const slides = recipes.flatMap((recipe) => {
  const image = recipeImage(
    recipe.data.heroImage,
    recipe.data.imageKind,
    recipe.data.imageOwnership,
  );
  return image
    ? [
        {
          title: recipe.data.title,
          href: `/recipes/${recipe.id}`,
          group: recipeGroup(recipe.id),
          description: recipe.data.description,
          image,
          alt: recipe.data.imageAlt ?? recipe.data.title,
        },
      ]
    : [];
});
---

<Base>
  <script
    slot="head"
    type="application/ld+json"
    set:html={safeJson(recipeListStructuredData(recipes, '/'))}
  />
  <main id="main" class="home-page">
    <article class="book home-book">
      <section class="book-page left" aria-labelledby="recipes-title">
        <div class="page-sticky">
          <p class="tag">Family recipes</p>
          <h1 id="recipes-title">What are we cooking today?</h1>
          <p class="page-dek">
            The recipes we cook at home, in English and Spanish. {recipes.length} so far.
          </p>
          <label class="search-field">
            <span class="sr-only">Search recipes and ingredients</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" />
              <path d="m16 16 5 5" />
            </svg>
            <input
              type="search"
              id="recipe-search"
              placeholder="Search by dish or ingredient"
              autocomplete="off"
            />
          </label>
          <div class="filter-bar" role="group" aria-label="Filter recipes">
            {GROUPS.map((group, index) => (
              <button
                type="button"
                data-filter={group}
                aria-pressed={index === 0}
                data-umami-event="cta"
                data-umami-event-label="filter"
              >
                {group}
              </button>
            ))}
          </div>
          <div class="results-line">
            <p id="recipe-results" role="status" aria-live="polite">
              {recipes.length} recipes
            </p>
            <button
              id="clear-filters"
              type="button"
              hidden
              data-umami-event="cta"
              data-umami-event-label="clear-filters"
            >
              Clear filters
            </button>
          </div>
          <div class="shelf">
            <a class="bubble" href="/recipes/sofrito-en">
              Start with sofrito. The rice and the beans both need it.
            </a>
            <MascotIcon variant="garlic" size={96} class="shelf-mascot" />
          </div>
        </div>
        <span class="folio" aria-hidden="true">
          2
        </span>
      </section>
      <section class="book-page right" id="recipes" aria-label="Recipes">
        <div class="recipe-grid">
          {recipes.map((recipe, index) => (
            <RecipeCard
              recipe={recipe}
              translated={Boolean(
                recipe.data.translationGroup &&
                all.some(
                  (other) =>
                    other.id !== recipe.id &&
                    other.data.translationGroup === recipe.data.translationGroup,
                ),
              )}
              index={index}
            />
          ))}
        </div>
        <div class="empty-state" id="empty-state" hidden>
          <MascotIcon variant="garlic-angry" size={64} class="state-mascot" />
          <h3>No recipes found.</h3>
          <p>Try another search term or clear the filters.</p>
        </div>
        <a class="index-link" href="/contents">
          Recipes, A–Z <span aria-hidden="true">↗</span>
        </a>
        <span class="folio" aria-hidden="true">
          3
        </span>
      </section>
    </article>
    <article class="book note-book" id="project-note" aria-labelledby="project-note-title">
      <section class="book-page left">
        <p class="tag">A personal project</p>
        <h2 id="project-note-title">Made for the fun of it.</h2>
        <div class="page-prose">
          <p>
            This cookbook is for fun and curiosity. I build software for a living, but I rarely get
            to direct a project or be as creative as I want to be.
          </p>
          <p>
            Here, I get to follow my own ideas, make the decisions, and express myself through the
            things I build. Our family recipes give that creativity a home.
          </p>
        </div>
        <a class="index-link" href="/about">
          Our kitchen ↗
        </a>
        <span class="folio" aria-hidden="true">
          {2 * recipes.length + 4}
        </span>
      </section>
      <section class="book-page right">
        <h2 class="page-subtitle">Made to be used.</h2>
        <p class="page-prose">
          Each recipe follows the same format. Check off ingredients, adjust quantities, tap the
          step you're on, print a copy, or use kitchen mode while you cook.
        </p>
        <img
          class="page-illustration"
          src="/mascots.webp"
          width="1536"
          height="1024"
          alt="A smiling garlic bulb and strawberry, Cookbook’s two kitchen companions."
          loading="lazy"
        />
        <span class="folio" aria-hidden="true">
          {2 * recipes.length + 5}
        </span>
      </section>
    </article>
  </main>
  <IdleBook slides={slides} total={recipes.length} />
</Base>
<script>
  const search = document.querySelector<HTMLInputElement>('#recipe-search');
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-recipe-card]')];
  const result = document.querySelector('#recipe-results');
  const clear = document.querySelector<HTMLButtonElement>('#clear-filters');
  const empty = document.querySelector<HTMLElement>('#empty-state');
  let selected = 'All recipes';
  const normalize = (text: string) =>
    text
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();
  function applyFilters() {
    const terms = normalize(search?.value ?? '')
      .trim()
      .split(/\s+/)
      .filter(Boolean);
    let count = 0;
    for (const card of cards) {
      const visible =
        (selected === 'All recipes' || card.dataset.group === selected) &&
        terms.every((term) => normalize(card.dataset.search ?? '').includes(term));
      card.hidden = !visible;
      if (visible) count++;
    }
    filters.forEach((button) =>
      button.setAttribute('aria-pressed', String(button.dataset.filter === selected)),
    );
    if (result)
      result.textContent = `${count} ${count === 1 ? 'recipe' : 'recipes'}${terms.length || selected !== 'All recipes' ? ' found' : ''}`;
    if (clear) clear.hidden = !terms.length && selected === 'All recipes';
    if (empty) empty.hidden = count !== 0;
  }
  search?.addEventListener('input', applyFilters);
  filters.forEach((button) =>
    button.addEventListener('click', () => {
      selected = button.dataset.filter ?? 'All recipes';
      applyFilters();
    }),
  );
  clear?.addEventListener('click', () => {
    if (search) search.value = '';
    selected = 'All recipes';
    applyFilters();
    search?.focus();
  });
</script>
