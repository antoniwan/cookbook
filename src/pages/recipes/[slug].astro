---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MascotIcon from '../../components/MascotIcon.astro';
import RecipePlaceholder from '../../components/RecipePlaceholder.astro';
import { allRecipes, publicRecipe, structuredRecipe, type Recipe } from '../../lib/catalogue';
import { recipeImage } from '../../lib/images';
import { recipeGroup, safeJson, SITE } from '../../lib/recipe';
import { breadcrumbStructuredData, durationLabel } from '../../lib/seo';
export async function getStaticPaths() {
  const recipes = await allRecipes();
  return recipes.map(recipe => ({ params: { slug: recipe.id }, props: { recipe, recipes } }));
}
interface Props { recipe: Recipe; recipes: Recipe[]; }
const { recipe, recipes } = Astro.props;
const { Content } = await render(recipe);
const image = recipeImage(recipe.data.heroImage, recipe.data.imageKind, recipe.data.imageOwnership);
const language = recipe.data.language[0];
const record = publicRecipe(recipe);
const yieldLabel = record.recipeYield && /^\d+$/.test(record.recipeYield) ? `${record.recipeYield} ${language === 'es' ? record.recipeYield === '1' ? 'porción' : 'porciones' : record.recipeYield === '1' ? 'serving' : 'servings'}` : record.recipeYield;
const twin = recipe.data.translationGroup ? recipes.find(other => other.id !== recipe.id && other.data.translationGroup === recipe.data.translationGroup) : undefined;
const imagePath = image && recipe.data.heroImage ? '/social/' + recipe.data.heroImage.split('/').at(-1)!.replace(/\.[^.]+$/, '.jpg') : '/social/recipe-placeholder.jpg';
const more = recipes.filter(other => other.id !== recipe.id && other.data.language[0] === language && (!recipe.data.translationGroup || other.data.translationGroup !== recipe.data.translationGroup)).slice(0, 3);
---
<Base title={`${recipe.data.title} — Cookbook`} description={recipe.data.description} path={`/recipes/${recipe.id}`} language={language} image={imagePath}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={safeJson(structuredRecipe(recipe, new URL(imagePath, SITE).href))} />
    <script type="application/ld+json" set:html={safeJson(breadcrumbStructuredData([{ name: 'Cookbook', url: `${SITE}/` }, { name: language === 'es' ? 'Recetas' : 'Recipes', url: `${SITE}/contents` }, { name: recipe.data.title, url: record.id }]))} />
    <link rel="alternate" type="text/markdown" href={`/recipes/${recipe.id}.md`} />
    <link rel="alternate" type="application/json" href={`/recipes/${recipe.id}.json`} />
    <link rel="alternate" hreflang={language} href={`${SITE}/recipes/${recipe.id}`} />
    {twin && <link rel="alternate" hreflang={twin.data.language[0]} href={`${SITE}/recipes/${twin.id}`} />}
  </Fragment>
  <main id="main" class="recipe-page wrap">
    <nav class="recipe-breadcrumb" aria-label={language === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}><a href="/">Cookbook</a><a href="/contents">{language === 'es' ? 'Recetas' : 'Recipes'}</a><span aria-current="page">{recipe.data.title}</span></nav>
    <header class="recipe-title-block"><p class="eyebrow">{language === 'es' ? 'Receta' : 'Recipe'}</p><h1>{recipe.data.title}</h1><div class="recipe-heading-bottom"><p>{recipe.data.description}</p>{twin && <a class="translation-link" href={`/recipes/${twin.id}`} lang={twin.data.language[0]} data-umami-event="cta" data-umami-event-label="language-switch">{language === 'es' ? 'Read in English' : 'Leer en español'} ↗</a>}</div></header>
    <dl class="recipe-facts"><div><dt>{language === 'es' ? 'Categoría' : 'Category'}</dt><dd>{recipeGroup(recipe.id)}</dd></div>{record.recipeCuisine && <div><dt>{language === 'es' ? 'Cocina' : 'Cuisine'}</dt><dd>{language === 'es' ? 'Puertorriqueña' : record.recipeCuisine}</dd></div>}{yieldLabel && <div><dt>{language === 'es' ? 'Rendimiento' : 'Yield'}</dt><dd>{yieldLabel}</dd></div>}{record.totalTime && <div><dt>{language === 'es' ? 'Tiempo total aproximado' : 'Approx. total time'}</dt><dd>{durationLabel(record.totalTime)}</dd></div>}{record.prepTime && record.cookTime && <><div><dt>{language === 'es' ? 'Preparación' : 'Preparation'}</dt><dd>{durationLabel(record.prepTime)}</dd></div><div><dt>{language === 'es' ? 'Cocción' : 'Cooking'}</dt><dd>{durationLabel(record.cookTime)}</dd></div></>}</dl>
    {image ? <figure class="recipe-hero"><Image class="recipe-photo" src={image} alt={recipe.data.imageAlt ?? recipe.data.title} widths={[640, 960, 1280]} sizes="(min-width: 1100px) 1100px, 100vw" width={1280} height={680} loading="eager" />{recipe.data.imageCredit && <figcaption>{recipe.data.imageCreditUrl ? <a href={recipe.data.imageCreditUrl} rel="noopener noreferrer">{recipe.data.imageCredit}</a> : recipe.data.imageCredit}{recipe.data.imageLicense && ` · ${recipe.data.imageLicense}`}</figcaption>}</figure> : <figure class="recipe-hero"><RecipePlaceholder variant="cover" language={language} /></figure>}
    <nav class="recipe-tools" aria-label={language === 'es' ? 'Herramientas de receta' : 'Recipe tools'}>
      <div class="recipe-jumps"><a href="#ingredients">{language === 'es' ? 'Ingredientes' : 'Ingredients'} ↓</a><a href="#equipment">{language === 'es' ? 'Equipo' : 'Equipment'} ↓</a><a href="#method">{language === 'es' ? 'Método' : 'Method'} ↓</a></div>
      <div class="recipe-actions"><button type="button" id="kitchen-mode" aria-pressed="false" data-umami-event="cta" data-umami-event-label="kitchen-mode"><span aria-hidden="true">☼</span> {language === 'es' ? 'Modo cocina' : 'Kitchen mode'}</button><button type="button" id="print-recipe" data-umami-event="cta" data-umami-event-label="print"><span aria-hidden="true">↗</span> {language === 'es' ? 'Imprimir' : 'Print'}</button></div>
      <p class="tool-status" id="kitchen-status" role="status" aria-live="polite"></p>
    </nav>
    <div class="recipe-body-layout">
      <details class="quantity-controls" aria-labelledby="quantities-title" id="quantity-panel" open hidden>
        <summary class="quantity-toggle"><span class="quantity-heading"><MascotIcon variant="garlic" size={32} /><span class="quantity-title" id="quantities-title">{language === 'es' ? 'Cantidades' : 'Quantities'}</span></span><span class="quantity-batch" id="quantity-batch">{language === 'es' ? '1× · Receta original' : '1× · Original recipe'}</span><span class="quantity-toggle-action"><span class="quantity-open-label">{language === 'es' ? 'Ocultar' : 'Hide'}</span><span class="quantity-closed-label">{language === 'es' ? 'Ajustar' : 'Adjust'}</span><span class="quantity-chevron" aria-hidden="true">⌄</span></span></summary>
        <div class="quantity-body"><div class="quantity-main">
        <p class="quantity-description">{language === 'es' ? 'Ajusta la receta a tu mesa.' : 'Make the amount you need.'}</p>
        {yieldLabel && <p class="quantity-yield">{language === 'es' ? 'Rendimiento original:' : 'Original yield:'} {yieldLabel}</p>}
        <div class="quantity-presets" role="group" aria-label={language === 'es' ? 'Multiplicadores de receta' : 'Recipe multipliers'}>{[.5, 1, 1.5, 2, 3].map(multiplier => <button type="button" data-multiplier={multiplier} aria-pressed={multiplier === 1} data-umami-event="cta" data-umami-event-label="multiplier-preset">{multiplier === .5 ? '½' : multiplier}×</button>)}</div>
        <form id="quantity-form"><label for="quantity-multiplier">{language === 'es' ? 'Multiplicador personalizado' : 'Custom multiplier'}</label><div class="quantity-custom"><input type="number" id="quantity-multiplier" min="0.25" max="20" step="any" value="1" required inputmode="decimal" aria-describedby="quantity-help" /><span aria-hidden="true">×</span><button type="submit" data-umami-event="cta" data-umami-event-label="multiplier-custom">{language === 'es' ? 'Aplicar' : 'Apply'}</button></div></form>
        <p class="quantity-help" id="quantity-help">{language === 'es' ? 'De 0.25× a 20×. 1× restaura la receta.' : 'From 0.25× to 20×. 1× restores the recipe.'}</p>
        <p id="quantity-status" class="quantity-status" role="status" aria-live="polite">{language === 'es' ? 'Cantidades originales.' : 'Original quantities.'}</p>
        </div><div class="quantity-secondary">
        <label class="quantity-compare"><input type="checkbox" id="show-originals" />{language === 'es' ? 'Mostrar cantidades originales' : 'Show original amounts'}</label>
        <div class="quantity-utilities"><button type="button" id="copy-ingredients" data-umami-event="cta" data-umami-event-label="copy-ingredients">{language === 'es' ? 'Copiar ingredientes' : 'Copy ingredients'}</button><button type="button" id="reset-checklist" data-umami-event="cta" data-umami-event-label="reset-checklist">{language === 'es' ? 'Reiniciar lista' : 'Reset checklist'}</button></div>
        <p class="tool-status" id="copy-status" role="status" aria-live="polite"></p>
        <details class="quantity-guidance"><summary>{language === 'es' ? 'Qué cambia y qué no' : 'What changes, what stays'}</summary><p>{language === 'es' ? 'Se ajustan cantidades, intervalos y equivalencias explícitas. Las alternativas ambiguas y las medidas sin cantidad quedan como están. Las partes siguen siendo proporciones, no conversiones a gramos o tazas.' : 'Amounts, ranges, and explicit equivalent measures scale together. Ambiguous alternatives and unmeasured ingredients stay as written. Parts remain ratios, not gram or cup conversions.'}</p><p>{language === 'es' ? 'Los tiempos, temperaturas, dimensiones y las cantidades dentro del método no cambian. Revisa esas cantidades y los huevos fraccionados. Ajusta el tamaño del recipiente.' : 'Times, temperatures, dimensions, and quantities within the method stay original. Review those quantities and fractional eggs. Adjust pan size as needed.'}</p></details>
        </div></div>
      </details>
      <div class="recipe-content"><p class="scale-summary" id="scale-summary" hidden></p><article class="recipe-prose" data-recipe-id={recipe.id} data-language={language}><Content /></article></div>
    </div>
    <aside class="recipe-caution"><MascotIcon variant="garlic-angry" size={38} /><p>{language === 'es' ? 'Al multiplicar ingredientes, revisa los tiempos de cocción por separado. No se multiplican automáticamente.' : 'When scaling ingredients, check cooking times separately. They do not multiply automatically.'}</p></aside>
    <section class="more-recipes"><h2>{language === 'es' ? 'Más recetas' : 'More recipes'}</h2><div>{more.map(other => <a href={`/recipes/${other.id}`}>{other.data.title}<span aria-hidden="true">↗</span></a>)}</div><a class="index-link" href="/#recipes">{language === 'es' ? 'Ver todas las recetas' : 'All recipes'} ↗</a></section>
  </main>
</Base>
<script>
  import { scaleIngredient } from '../../lib/recipe';
  const prose = document.querySelector<HTMLElement>('.recipe-prose');
  const language = prose?.dataset.language ?? 'en';
  prose?.querySelectorAll<HTMLElement>('[id^="step-"]').forEach((step, index) => {
    const link = document.createElement('a');
    link.href = `#${step.id}`;
    link.className = 'step-link';
    link.textContent = '↗';
    link.setAttribute('aria-label', language === 'es' ? `Enlace al paso ${index + 1}` : `Link to step ${index + 1}`);
    (step.querySelector('p') ?? step).append(' ', link);
  });
  const checks: HTMLInputElement[] = [];
  const labels: { node: HTMLElement; original: string; html: string; comparison: HTMLElement; review: HTMLElement }[] = [];
  const storageKey = `cookbook:ingredients:${prose?.dataset.recipeId}`;
  let checked: number[] = [];
  try { checked = JSON.parse(localStorage.getItem(storageKey) ?? '[]'); if (!Array.isArray(checked)) checked = []; } catch {}
  const ingredientHeading = prose?.querySelector('#ingredients');
  let element = ingredientHeading?.nextElementSibling;
  while (element && element.tagName !== 'H2') {
    for (const item of element.querySelectorAll<HTMLLIElement>('li')) {
      const index = checks.length;
      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.checked = checked.includes(index);
      const label = document.createElement('label');
      const text = document.createElement('span');
      text.append(...Array.from(item.childNodes));
      const comparison = document.createElement('small');
      comparison.className = 'ingredient-original';
      comparison.hidden = true;
      comparison.textContent = `Original: ${text.textContent}`;
      const review = document.createElement('small');
      review.className = 'ingredient-review';
      review.hidden = true;
      review.textContent = language === 'es' ? 'Sin cambios: revisar' : 'As written: review';
      const description = document.createElement('span');
      description.append(text, comparison, review);
      label.append(checkbox, description);
      item.append(label);
      item.classList.add('ingredient-item');
      checks.push(checkbox);
      labels.push({ node: text, original: text.textContent ?? '', html: text.innerHTML, comparison, review });
      checkbox.addEventListener('change', () => { try { localStorage.setItem(storageKey, JSON.stringify(checks.flatMap((check, position) => check.checked ? [position] : []))); } catch {} });
    }
    element = element.nextElementSibling;
  }
  document.querySelector('#print-recipe')?.addEventListener('click', () => window.print());
  document.querySelector('#reset-checklist')?.addEventListener('click', () => { checks.forEach(check => check.checked = false); try { localStorage.removeItem(storageKey); } catch {} });
  const multiplierButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-multiplier]')];
  const multiplierInput = document.querySelector<HTMLInputElement>('#quantity-multiplier');
  const originals = document.querySelector<HTMLInputElement>('#show-originals');
  const quantityStatus = document.querySelector('#quantity-status');
  const quantityBatch = document.querySelector('#quantity-batch');
  const scaleSummary = document.querySelector<HTMLElement>('#scale-summary');
  const copyStatus = document.querySelector('#copy-status');
  let currentMultiplier = 1;
  function updateComparisons() {
    labels.forEach(label => label.comparison.hidden = !originals?.checked || currentMultiplier === 1 || label.node.textContent === label.original);
  }
  function updateQuantities(multiplier: number) {
    if (!Number.isFinite(multiplier) || multiplier < .25 || multiplier > 20) return;
    currentMultiplier = multiplier;
    if (quantityBatch) quantityBatch.textContent = multiplier === 1 ? language === 'es' ? '1× · Receta original' : '1× · Original recipe' : language === 'es' ? `${multiplier}× · Receta ajustada` : `${multiplier}× · Adjusted recipe`;
    if (multiplierInput) multiplierInput.value = String(multiplier);
    multiplierButtons.forEach(button => button.setAttribute('aria-pressed', String(Number(button.dataset.multiplier) === multiplier)));
    let changed = 0;
    labels.forEach(label => {
      const scaled = scaleIngredient(label.original, multiplier);
      if (scaled === label.original) label.node.innerHTML = label.html;
      else { label.node.textContent = scaled; changed++; }
      label.review.hidden = multiplier === 1 || scaled !== label.original || !/[\d¼½¾⅓⅔⅛⅜⅝⅞]/.test(label.original);
    });
    updateComparisons();
    if (quantityStatus) quantityStatus.textContent = multiplier === 1 ? language === 'es' ? 'Cantidades originales.' : 'Original quantities.' : language === 'es' ? `${multiplier}× · ${changed} líneas ajustadas; ${labels.length - changed} sin cambios.` : `${multiplier}× · ${changed} lines adjusted; ${labels.length - changed} unchanged.`;
    if (scaleSummary) {
      scaleSummary.hidden = multiplier === 1;
      scaleSummary.textContent = language === 'es' ? `Ingredientes a ${multiplier}×. Las cantidades del método y los tiempos siguen siendo los originales. Revisa las líneas sin cambios.` : `Ingredients at ${multiplier}×. Method quantities and cooking times stay original. Review unchanged lines.`;
    }
    if (copyStatus) copyStatus.textContent = '';
  }
  multiplierButtons.forEach(button => button.addEventListener('click', () => updateQuantities(Number(button.dataset.multiplier))));
  document.querySelector('#quantity-form')?.addEventListener('submit', event => {
    event.preventDefault();
    if (multiplierInput?.reportValidity()) updateQuantities(multiplierInput.valueAsNumber);
  });
  originals?.addEventListener('change', updateComparisons);
  document.querySelector('#copy-ingredients')?.addEventListener('click', async () => {
    const title = document.querySelector('h1')?.textContent ?? 'Cookbook';
    const heading = language === 'es' ? `Ingredientes · ${currentMultiplier}×` : `Ingredients · ${currentMultiplier}×`;
    const note = language === 'es' ? 'Revisa las líneas sin cambios y las cantidades dentro del método. Los tiempos no cambian.' : 'Review unchanged lines and quantities within the method. Cooking times do not change.';
    try {
      await navigator.clipboard.writeText([title, heading, ...labels.map(label => `- ${label.node.textContent}${label.review.hidden ? '' : ` (${label.review.textContent})`}`), '', note].join('\n'));
      if (copyStatus) copyStatus.textContent = language === 'es' ? 'Ingredientes copiados.' : 'Ingredients copied.';
    } catch { if (copyStatus) copyStatus.textContent = language === 'es' ? 'No se pudo copiar. Selecciona y copia la lista de ingredientes.' : 'Could not copy. Select and copy the ingredient list instead.'; }
  });
  const quantityPanel = document.querySelector<HTMLDetailsElement>('#quantity-panel');
  if (quantityPanel) quantityPanel.hidden = false;
  const kitchen = document.querySelector<HTMLButtonElement>('#kitchen-mode');
  const status = document.querySelector('#kitchen-status');
  let wakeLock: WakeLockSentinel | null = null;
  let kitchenEnabled = false;
  async function requestWakeLock() {
    if (!kitchenEnabled || !('wakeLock' in navigator) || document.visibilityState !== 'visible') return;
    try {
      wakeLock = await navigator.wakeLock.request('screen');
      if (status) status.textContent = language === 'es' ? 'La pantalla permanece encendida.' : 'Screen stays awake while this page is visible.';
    } catch { if (status) status.textContent = language === 'es' ? 'Modo cocina activo. No se pudo mantener la pantalla encendida.' : 'Kitchen mode is on. Screen wake lock is unavailable.'; }
  }
  kitchen?.addEventListener('click', async () => {
    kitchenEnabled = !kitchenEnabled;
    kitchen.setAttribute('aria-pressed', String(kitchenEnabled));
    document.body.classList.toggle('kitchen-mode', kitchenEnabled);
    if (kitchenEnabled) {
      if (quantityPanel) quantityPanel.open = false;
      if (status) status.textContent = language === 'es' ? 'Modo cocina activo.' : 'Kitchen mode is on.';
      await requestWakeLock();
    } else { await wakeLock?.release(); wakeLock = null; if (status) status.textContent = ''; }
  });
  document.addEventListener('visibilitychange', requestWakeLock);
</script>
