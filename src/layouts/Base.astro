---
import '../styles/global.css';
import { safeJson, SITE } from '../lib/recipe';
import { websiteStructuredData } from '../lib/seo';
import Wordmark from '../components/Wordmark.astro';
interface Props { title?: string; description?: string; path?: string; language?: 'en' | 'es'; image?: string; }
const { title = 'Cookbook — Recipes from our kitchen', description = 'Family recipes by Antonio, in English and Spanish.', path = '/', language = 'en', image = '/social/cookbook.jpg' } = Astro.props;
const canonical = new URL(path, SITE).href;
const isPreview = import.meta.env.PROD && process.env.VERCEL_ENV === 'preview';
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfbf9" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Antonio" />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon-garlic.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="alternate" type="application/json" href="/recipes.json" title="Recipe catalogue" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Cookbook" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Cookbook" />
    <meta property="og:image" content={new URL(image, SITE).href} />
    <meta name="twitter:card" content="summary_large_image" />
    {path === '/' && <script type="application/ld+json" set:html={safeJson(websiteStructuredData())} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <Wordmark />
      <nav aria-label="Main navigation">
        <a href="/#recipes">Recipes</a>
        <a href="/contents">A–Z</a>
        <a href="/about">Our kitchen</a>
      </nav>
      <a class="personal-link" href="https://antoniwan.online">By Antonio <span aria-hidden="true">↗</span></a>
    </header>
    <slot />
    <footer class="site-footer wrap">
      <Wordmark />
      <p>The strawberry knows too much.</p>
      <a class="professional-mark" href="https://antoniwan.online" aria-label="Antonio’s professional mark"><img src="/professional-mark.svg" alt="" width="24" height="24" /></a>
      <div class="footer-links"><a href="https://notes.antoniwan.online">Notes ↗</a><a href="https://antoniwan.online">Antonio ↗</a><a href="/rss.xml">RSS</a><a href="/recipes.json">Recipe data</a><a href="https://github.com/antoniwan/cookbook">Source ↗</a></div>
    </footer>
  </body>
</html>
