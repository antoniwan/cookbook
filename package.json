{
  "name": "cookbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": "github:antoniwan/cookbook",
  "homepage": "https://cookbook.antoniwan.online",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.ts",
    "validate": "node scripts/validate-build.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,astro}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/sitemap": "3.7.4",
    "@vercel/analytics": "2.0.1",
    "astro": "7.3.5",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "lint-staged": "17.6.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "simple-git-hooks": "2.14.0",
    "stylelint": "17.16.0",
    "typescript": "6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.astro": [
      "eslint --fix --no-warn-ignored",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "!(*.{js,mjs,cjs,ts,mts,cts,astro,css})": "prettier --write --ignore-unknown"
  }
}
